# ==============================================================================
# ADAM v40 — Environment Configuration Template
# DGEN Technologies Pvt. Ltd. — Kolkata, India
# ==============================================================================
# Single source of truth is config.py. Every variable here is optional except
# GEMINI_API_KEY. All others default to safe, hardware-measured values.
# ==============================================================================

# ── API Credentials ──────────────────────────────────────────────────────────
# Primary: GEMINI_API_KEY (also falls back to GOOGLE_API_KEY if present)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_live_api_key_here

# ── Model & Persona ───────────────────────────────────────────────────────────
# Live Model: gemini-2.0-flash-exp (default) or gemini-3.1-flash-live
# LIVE_MODEL=gemini-2.0-flash-exp
# Voice: Aoede (default), Puck, Charon, Kore, Fenrir
# VOICE=Aoede

# ── Idle Mode Safety Trap (Fault A3) ───────────────────────────────────────────
# 0 = Disabled (RECOMMENDED). Prevents ADAM from getting trapped in idle mode
# and ignoring user speech after an unprompted idle nudge. Set to 1 only if idle
# nudges are required and tested.
ENABLE_IDLE=0

# ── Hardware Serial Interface (Pi <-> ESP32-CAM) ──────────────────────────────
# PL011 hardware UART exposed on GPIO14/15 via dtoverlay=disable-bt
PI_UART_PORT=/dev/serial0
PI_UART_BAUD=921600

# ── Audio Devices (Google voiceHAT Soundcard) ──────────────────────────────────
# Addressed by stable ALSA card name ("sndrpigooglevoi") rather than index
CAPTURE_DEVICE=plughw:sndrpigooglevoi,0
PLAYBACK_DEVICE=plughw:sndrpigooglevoi,0

# ── Microphone Channel Selection (Fault A8 / A11) ──────────────────────────────
# auto: Dynamically monitors acoustic responsiveness and automatically drops a dead
#       channel (e.g. Vero board soldering defect) to recover 11.7-21 dB consonant SNR.
# left: Force left INMP441 mic only.
# right: Force right INMP441 mic only.
# mix: Average left and right (use only if both mics are confirmed healthy).
MIC_CHANNEL=auto

# ── Audio Gain & Turn-Taking Tunables ─────────────────────────────────────────
# Software playback gain (1.0 = baseline, prevents clipping distortion)
SPEAKER_GAIN=1.0
# Turn-taking hangover in seconds (1.0s prevents Gemini from cutting sentences in half)
MIC_VAD_HANGOVER_S=1.0
# Number of passing chunks (M) inside sliding window (N) for VAD onset (quorum)
MIC_VAD_ONSET_CHUNKS=3
MIC_VAD_ONSET_WINDOW=6

# ── Neck Actuation & Acoustic Decoupling ──────────────────────────────────────
# Pin for pan servo (gpiozero AngularServo direct PWM)
NECK_GPIO_PIN=12
# Auto-detach PWM after move to eliminate motor hum that deafens the microphones!
NECK_SERVO_HOLD_S=0.6
# Mechanical settling window where gate opening is temporarily suppressed
NECK_SERVO_SETTLE_S=2.0

# ── Companion Laptop Agent (LAN Control) ──────────────────────────────────────
# Static IP fallback if mDNS discovery (_adam-agent._tcp.local.) fails
# LAPTOP_AGENT_IP=192.168.1.50
LAPTOP_AGENT_PORT=5000
AGENT_TOKEN=change_this_secret_token_in_production

# ── Offline Wake-Word Model ───────────────────────────────────────────────────
# VOSK_MODEL_PATH=/home/pi/adam/vosk-model-small-en-us-0.15
