# ==============================================================================
# ADAM AI — Environment Configuration Template
# DGEN Technologies Pvt. Ltd.
# ==============================================================================

# Google Gemini API Key (Required for Multimodal Live WebSocket session)
# Generate your key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Selection
# Recommended: gemini-2.0-flash-exp (or gemini-3.1-flash-live)
GEMINI_MODEL=gemini-2.0-flash-exp

# Hardware Serial Interface
# Connected to ESP32-CAM via PL011 UART
SERIAL_PORT=/dev/serial0
SERIAL_BAUD=921600

# Audio I/O Configuration
# Google voiceHAT soundcard configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CAPTURE_DEVICE=plughw:CARD=sndrpigooglevoi,DEV=0
AUDIO_PLAYBACK_DEVICE=plughw:CARD=sndrpigooglevoi,DEV=0

# Sound Localization (DOA)
DOA_ENABLED=true
MIC_DISTANCE_METERS=0.065

# Neck Pan Actuation (Pi Zero 2 W direct GPIO)
PAN_SERVO_PIN=12
PAN_MIN_PW=0.0005
PAN_MAX_PW=0.0025

# Companion Laptop Agent (Optional LAN control)
LAPTOP_AGENT_HOST=adam-laptop.local
LAPTOP_AGENT_PORT=5000
LAPTOP_AGENT_TOKEN=change_this_secret_token_in_production
